name: checks
on: [push, pull_request]
permissions:
  contents: read
jobs:
  checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install uv==0.9.4
      - run: uv sync --frozen
      - run: uv run ruff check src tests
      - run: uv run mypy src tests
      - run: uv run pytest -q
